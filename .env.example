# Environment Configuration Example
# AI News Intelligence Platform

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI News Intelligence Platform"
API_V1_STR=/api/v1
API_BASE_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://abdullah-shaikh-portfolio.vercel.app","https://abdullah-ai-systems-portfolio.vercel.app"]

# Canonical Database Configuration (Single Source of Truth)
# For local development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_news_intel
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_news_intel_test

# For Neon PostgreSQL (Free Tier):
# Application runtime uses Neon's pooled connection string:
# DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional explicit direct connection for migrations (or automatic fallback without -pooler.):
# DIRECT_DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=300
DB_ECHO=false

# AI / LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Resend / Email Provider (Phase 17 & 18)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=notifications@example.com
DISPATCH_SECRET_TOKEN=
DISPATCH_CRON_ENABLED=false
DISPATCH_SCHEDULE_HOUR_UTC=3
DISPATCH_SCHEDULE_MINUTE_UTC=30
DISPATCH_SCHEDULER_FREQUENCY="0 * * * *"
NEWS_COLLECTION_SCHEDULE_UTC="03:30"
DELIVERY_DUE_WINDOW_MINUTES=60

# Safe Retention Configuration
NEWS_RETENTION_DAYS=90
DELIVERY_RECORD_RETENTION_DAYS=180

# External Service Keys
YOUTUBE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
